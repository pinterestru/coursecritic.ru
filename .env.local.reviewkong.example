# Per-site local dev env for reviewkong.
# Copy to `.env.local.reviewkong` (gitignored); prepare-site copies it over
# `.env.local` when SITE_CONFIG=reviewkong.

SITE_CONFIG=reviewkong
LOG_LEVEL=debug

# No CMS integration — content is hardcoded in src/sites/(reviewkong)/data/.
# Outbound affiliate links use the shared /click redirect and the default
# tracker backend.
API_BASE_URL=
API_MEDIA_URL=
