# Per-site local dev env for edsider.
# Copy to `.env.local.edsider` (gitignored); prepare-site will copy it over
# `.env.local` when SITE_CONFIG=edsider.

SITE_CONFIG=edsider
LOG_LEVEL=debug

# No CMS integration planned for edsider — content is hardcoded in src/sites/(edsider)/data/.
API_BASE_URL=
API_MEDIA_URL=
