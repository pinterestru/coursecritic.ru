# Nginx config for kodomania.ru → site-ui (SITE_CONFIG=kodomania) on 127.0.0.1:3007
#
# Deploy:
#   sudo cp nginx.conf.kodomania /etc/nginx/sites-available/kodomania.ru
#   sudo ln -s /etc/nginx/sites-available/kodomania.ru /etc/nginx/sites-enabled/kodomania.ru
#   sudo nginx -t && sudo systemctl reload nginx

upstream kodomania_upstream {
    server 127.0.0.1:3007 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name kodomania.ru www.kodomania.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://kodomania.ru$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name kodomania.ru www.kodomania.ru;

    if ($host = www.kodomania.ru) {
        return 301 https://kodomania.ru$request_uri;
    }

    ssl_certificate     /etc/letsencrypt/live/kodomania.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kodomania.ru/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/kodomania.ru/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL_kodomania:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml
               application/xml+rss application/atom+xml application/manifest+json;

    client_max_body_size 10M;
    client_body_timeout 30;
    client_header_timeout 30;
    send_timeout 30;

    location /_next/static/ {
        proxy_pass http://kodomania_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /_next/image {
        proxy_pass http://kodomania_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        add_header Cache-Control "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400";
        add_header Vary "Accept" always;
    }

    location /api/ {
        proxy_pass http://kodomania_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /api/health {
        proxy_pass http://kodomania_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        access_log off;
        proxy_read_timeout 5s;
        proxy_connect_timeout 5s;
    }

    location / {
        proxy_pass http://kodomania_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_set_header Next-Action $http_next_action;
        proxy_set_header Next-Router-State-Tree $http_next_router_state_tree;
        proxy_set_header RSC $http_rsc;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    access_log /var/log/nginx/kodomania.ru-access.log combined buffer=32k flush=5m;
    error_log  /var/log/nginx/kodomania.ru-error.log warn;
}
