# Per-site local dev env for promoyeti (promoyeti.com).
# Copy to `.env.local.promoyeti` (gitignored); prepare-site copies it over
# `.env.local` when SITE_CONFIG=promoyeti.

SITE_CONFIG=promoyeti
LOG_LEVEL=debug

# No CMS integration — content is hardcoded in src/sites/(promoyeti)/data/.
# Outbound affiliate links use the shared /click redirect and the default
# tracker backend.
API_BASE_URL=
API_MEDIA_URL=
