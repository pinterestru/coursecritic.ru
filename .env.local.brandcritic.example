# Per-site local dev env for brandcritic.
# Copy to `.env.local.brandcritic` (gitignored); prepare-site copies it over
# `.env.local` when SITE_CONFIG=brandcritic.

SITE_CONFIG=brandcritic
LOG_LEVEL=debug

# No CMS integration — content is hardcoded in src/sites/(brandcritic)/data/.
# Outbound affiliate links use the shared /click redirect and the default
# tracker backend.
API_BASE_URL=
API_MEDIA_URL=
