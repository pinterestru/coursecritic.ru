# Per-site local dev env for coursecritic.
# Copy to `.env.local.coursecritic` (gitignored). When you run
# `SITE_CONFIG=coursecritic pnpm dev|build`, prepare-site copies this
# file over `.env.local`, which is what Next.js reads.

SITE_CONFIG=coursecritic
LOG_LEVEL=debug

# CMS — fill in if this site pulls articles from the product API.
# Leave blank for a hardcoded-content site.
API_BASE_URL=
API_MEDIA_URL=
