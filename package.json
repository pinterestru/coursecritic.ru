{
  "name": "site-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare-site": "node scripts/prepare-site.mjs",
    "dev": "pnpm prepare-site && concurrently -k -n prep,next -c yellow,green \"node scripts/prepare-site.mjs --watch\" \"next dev\"",
    "build": "pnpm prepare-site && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^16.2.2",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.2",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0"
  }
}
