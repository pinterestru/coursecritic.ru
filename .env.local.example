# Common local-dev env — copy to `.env.local`, safe to share across sites.
# For per-site secrets / overrides, create `.env.local.<site-id>` and
# `pnpm prepare-site` (or `pnpm dev` / `pnpm build`) will copy it over .env.local.

# Required at build time: which site to activate.
# Must match a folder (<name>) under src/sites/, e.g. (coursecritic) → SITE_CONFIG=coursecritic
SITE_CONFIG=coursecritic

# Logging level for the server-side pino logger.
LOG_LEVEL=info
